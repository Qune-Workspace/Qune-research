.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
# Raw downloaded data is re-fetched by the scripts, never committed.
**/data/raw/
.env
.worklock
# Paper-trading fetches are provenance-hashed in paper-log/manifest.json, never committed.
**/paper-log/raw/
# Prediction scoring fetches are provenance-hashed in predictions/manifest.json, never committed.
predictions/raw/
# Coverage data (make coverage).
.coverage
coverage.xml
htmlcov/

# Study 010 forward record: the writer's lock file
research/010-factor-momentum-french-us/paper-log/*.lock
# Study 010 forward scoring: lock and temp files only (score.json itself is committed).
**/results/forward/*.lock
**/results/forward/*.tmp
**/paper-log/releases/*.tmp
